[Unit]
Description=ANIME VOID Profile Studio API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=avstudio
Group=avstudio
WorkingDirectory=/opt/anime-void-studio/backend
EnvironmentFile=/etc/anime-void-studio.env
ExecStart=/opt/anime-void-studio/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 45 --bind 127.0.0.1:8128 wsgi:application
Restart=on-failure
RestartSec=4
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/anime-void-studio

[Install]
WantedBy=multi-user.target
