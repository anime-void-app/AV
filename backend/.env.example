# COPY TO /etc/anime-void-studio.env ON THE SERVER, NOT INTO GITHUB.
# Restrict permissions: chmod 600. No real values are included in this file.
APP_ENV=production
DB_PATH=/var/lib/anime-void-studio/studio.sqlite3
ALLOWED_ORIGINS=https://anime-void-app.github.io
TRUST_PROXY=1
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
# OWNER_ACCOUNT_ID is the UUID returned by `python manage.py account YOUR_LOGIN`.
OWNER_ACCOUNT_ID=
PUBLIC_PROFILE_URL=https://anime-void-app.github.io/AV/profile.html
# Start with test. Test and live MUST use different database paths.
PAYMENT_MODE=test
REAL_PAYMENTS_ENABLED=0
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
WEBHOOK_SECRET=
MERCHANT_NAME=
SUPPORT_EMAIL=
TERMS_VERSION=17.0
TERMS_URL=
PRIVACY_URL=
REFUND_URL=
# provider: send receipt payload to your connected fiscal solution.
# external: ONLY if you have separately implemented/verified the required receipt workflow.
RECEIPT_MODE=provider
FISCAL_READY=0
# Confirm these values with your tax/fiscal settings; 1 is "without VAT", not a universal setting.
RECEIPT_VAT_CODE=1
RECEIPT_SUBJECT=service
